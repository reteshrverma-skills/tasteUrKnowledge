# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign session cookies. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Stripe - monthly subscription per child (see src/lib/billing.ts).
# Test-mode keys start sk_test_ / whsec_ ; the price id starts price_.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_ID=price_replace-me
# Public address of the site, used for Stripe's return links and the links in
# password-reset emails. In production: https://practicelabs.ai
APP_URL=http://localhost:3000
# "true" locks unpaid children out of every subject. Leave unset until
# existing parents have had the chance to subscribe.
PAYMENTS_ENFORCED=

# Claude API key for the admin "Generate with AI" comprehension drafts.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Email via Resend (see src/lib/email.ts). Without a key, emails are printed
# to the server log instead of sent. The key starts re_ (Resend > API Keys).
RESEND_API_KEY=re_replace-me
# Sender shown to parents. Its domain must be verified in Resend > Domains.
MAIL_FROM=Practice Labs <support@practicelabs.ai>
