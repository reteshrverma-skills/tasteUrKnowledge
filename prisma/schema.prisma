// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // The query engine is a native binary, so the host it runs on must be built
  // for. "native" covers this Windows machine; the debian target covers Azure
  // App Service and every other Linux host.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  STUDENT
  PARENT
  ADMIN
  /// Read-only statistics at /director (migration 035).
  PRODUCT_DIRECTOR
  /// Runs one school at /school: classes, teachers, pupils (migration 036).
  SCHOOL_ADMIN
  /// Opens pupils for practice from /teacher (migration 036).
  TEACHER
}

/// User's login Id
model UserProfile {
  id               BigInt    @id @default(autoincrement())
  fName            String?
  mName            String?
  lName            String?
  /// Login user id
  profileName      String    @unique
  /// bcrypt hash of the login password. Null for school pupils, who are
  /// opened by their teacher and can never sign in themselves (migration 036).
  profilePassword  String?
  userType         UserType  @default(STUDENT)
  /// Legacy one-to-one link, kept only so older data is not lost. The live
  /// link is UserStudentDetails.parentId, which lets one parent hold many
  /// children. Nothing reads this.
  studentParentRef String?   @map("student_parent_ref")
  isActive         Boolean   @default(true)
  createDate       DateTime  @default(now())
  /// When a parent agreed to the Terms & Copyright notice at sign-up.
  termsAcceptedAt  DateTime? @db.Timestamptz(3)
  /// The one session allowed for this account (migration 034): a random key
  /// set at login and carried in the token. Null after logout or a password
  /// reset, which ends the session everywhere.
  activeSessionKey String?
  /// ISO 3166-1 alpha-2 code of the country the account registered from
  /// (migration 031). Null for accounts made before it was asked.
  countryCode      String?   @db.Char(2)
  country          Country?  @relation(fields: [countryCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  /// The school a SCHOOL_ADMIN, TEACHER or school pupil belongs to (migration
  /// 036). Null for parents, home students, admins and product directors.
  schoolId              BigInt?
  school                School? @relation("SchoolMembers", fields: [schoolId], references: [id], onDelete: Restrict)
  /// True for teachers, who sign in on several classroom devices at once; the
  /// one-session rule applies to everyone else.
  allowMultipleSessions Boolean @default(false)
  /// bcrypt hash of a teacher's 4-digit PIN, which ends a pupil's turn on a
  /// classroom device and returns it to the teacher's screen.
  pinHash               String?

  schoolsCreated  School[]             @relation("SchoolCreatedBy")
  classesTaught   SchoolClassTeacher[]
  classroomTurns  ClassroomSession[]   @relation("ClassroomStudent")
  classroomOpened ClassroomSession[]   @relation("ClassroomTeacher")

  personalDetails UserPersonalDetails?
  studentDetails  UserStudentDetails?
  /// Children, when this profile is a PARENT.
  children        UserStudentDetails[]     @relation("ParentChildren")
  paymentDetails  UserPaymentDetails[]
  mathsTests      TestTrackerMathMain[]
  mathsAnswers    TestTrackerMath[]
  englishTests    TestTrackerEnglishMain[]
  englishAnswers  TestTrackerEnglish[]
  nvrTests        TestTrackerNvrMain[]
  nvrAnswers      TestTrackerNvr[]
  loginSessions   UserLoginSession[]
  resetTokens     PasswordResetToken[]
  /// Topics a parent has asked this child to work on (as the STUDENT).
  focusTopics     StudentFocus[]           @relation("FocusStudent")
  /// Topics this PARENT has set for their children.
  focusSet        StudentFocus[]           @relation("FocusSetBy")

  /// Grammar School, GCSE or A-Level (migration 032). Every student query
  /// filters on it, so a child only ever sees their own programme's content.
  programmeCode String    @default("GRAMMAR")
  programme     Programme @relation(fields: [programmeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([countryCode])
  @@index([programmeCode])
  @@index([schoolId])
  @@map("userProfile")
}

/// A topic a parent picked from "Focus next" for their child to practise.
/// Shown on the child's dashboard until the parent removes it; removing sets
/// clearedAt rather than deleting the row, so there is a history of focuses.
model StudentFocus {
  id        BigInt       @id @default(autoincrement())
  studentId BigInt
  student   UserProfile  @relation("FocusStudent", fields: [studentId], references: [id], onDelete: Cascade)
  setById   BigInt?
  setBy     UserProfile? @relation("FocusSetBy", fields: [setById], references: [id], onDelete: SetNull)
  /// "English" | "Maths" | "Verbal Reasoning" | "Non-Verbal"
  subject   String
  /// What the parent saw: the English question type, or the subtopic.
  label     String
  /// English: the question type. Others: the bank's topic.
  topic     String?
  /// The bank's subtopic; null for English.
  subTopic  String?
  /// Difficulty the round starts at - where the child last practised it.
  level     String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  clearedAt DateTime?    @db.Timestamptz(3)

  @@index([studentId, clearedAt])
  @@map("studentFocus")
}

/// Grammar School (11+), GCSE and A-Level: which exam a child prepares for,
/// and which every piece of content belongs to (migration 032).
model Programme {
  /// "GRAMMAR" | "GCSE" | "ALEVEL"
  code      String  @id
  name      String
  sortOrder Int     @default(100) @db.SmallInt
  /// False: not offered when adding a child (no content loaded yet).
  isActive  Boolean @default(true)

  users          UserProfile[]
  schools        School[]
  englishComps   GsEnglishComp[]
  mathsQuestions GsMathsQuestion[]
  nvrQuestions   GsNvrQuestion[]
  vrQuestions    GsVrQuestion[]

  @@map("coreProgramme")
}

/// Every ISO 3166-1 country, for the country drop-downs (migration 031).
model Country {
  /// ISO 3166-1 alpha-2, e.g. "GB".
  code      String  @id @db.Char(2)
  name      String
  /// International dialling code, e.g. "+44"; null where there is none.
  dialCode  String?
  /// Lower sorts first: the United Kingdom is 1, everything else 100.
  sortOrder Int     @default(100) @db.SmallInt
  /// False hides a country from the forms without deleting it.
  isActive  Boolean @default(true)

  users UserProfile[]

  @@map("coreCountry")
}

/// One row per login, closed on logout: an audit trail of who was on and when.
/// logoutAt stays null for a session still open or abandoned (tab closed), as
/// the app only ever sees an explicit logout.
model UserLoginSession {
  id        BigInt      @id @default(autoincrement())
  userId    BigInt
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime    @default(now()) @db.Timestamptz(3)
  logoutAt  DateTime?   @db.Timestamptz(3)
  /// "logout" for an explicit sign-out; null otherwise.
  endReason String?

  @@index([userId, loginAt])
  @@map("userLoginSession")
}

/// A single-use, short-lived password reset link.
///
/// Only the SHA-256 of the token is kept. A password cannot be recovered and
/// sent - profilePassword is a bcrypt hash - so the person follows a link and
/// chooses a new one instead.
model PasswordResetToken {
  id        BigInt      @id @default(autoincrement())
  userId    BigInt
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the token that went out in the link; never the token.
  tokenHash String      @unique
  expiresAt DateTime    @db.Timestamptz(3)
  /// Set the moment the link is spent, so it works exactly once.
  usedAt    DateTime?   @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("passwordResetToken")
}

model UserPersonalDetails {
  id             BigInt      @id @default(autoincrement())
  userDetailsId  BigInt      @unique @map("userDetails_Id")
  profile        UserProfile @relation(fields: [userDetailsId], references: [id], onDelete: Cascade)
  userAdd1       String?
  userAdd2       String?
  userAdd3       String?
  userCity       String?
  userCounty     String?
  userZipCode    String?
  contactNumber1 String?
  contactNumber2 String?
  emailAddress   String?

  @@map("userPersonalDetails")
}

/// School details for a STUDENT profile, including which Year they are in.
model UserStudentDetails {
  id            BigInt       @id @default(autoincrement())
  studentId     BigInt       @unique
  student       UserProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// The PARENT account that manages this child.
  /// SetNull, not Cascade: a child's work must outlive the parent account that
  /// happened to create it.
  parentId      BigInt?
  parent        UserProfile? @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  /// Year.id - drives which comprehensions the student is shown
  studentYear   String?
  year          Year?        @relation(fields: [studentYear], references: [id], onDelete: SetNull)
  schoolAdd1    String?
  schoolAdd2    String?
  schoolAdd3    String?
  schoolCity    String?
  schoolCountry String?

  /// Difficulty levels this student may access; false locks the level away.
  /// The ladder is Starter, Explorer, Navigator, Challenger, Master.
  starter     Boolean? @default(false)
  explorer    Boolean? @default(false)
  navigator   Boolean? @default(false)
  challenger  Boolean? @default(false)
  master      Boolean? @default(false)
  /// Retired from the ladder. Kept so past grants are not thrown away.
  thinkHarder Boolean? @default(false)

  @@index([studentYear])
  @@index([parentId])
  @@map("userStudentDetails")
}

model UserPaymentDetails {
  id            BigInt      @id @default(autoincrement())
  userProfileId BigInt      @map("userProfile_Id")
  profile       UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  paymentId     String?
  paymentAmount Decimal?    @db.Decimal(10, 2)
  profileActive DateTime?   @db.Date

  @@map("userPaymentDetails")
}

/// English comprehension: the story plus the year/subject it belongs to.
model GsEnglishComp {
  id                  BigInt    @id @default(autoincrement())
  compStory           String?
  difficultyLevel     String?
  yearName            String?
  subjectName         String?
  label               String?
  /// Students see a comprehension only once an admin has approved it. Null
  /// counts as not approved, so a new or AI-drafted passage starts hidden.
  approvedByAdmin     Boolean?  @map("approvedbyadmin")
  approvedByAdminDate DateTime? @map("approvedbyadmindate") @db.Date
  createdDate         DateTime? @map("createddate") @db.Date

  questions GsEnglishQuestion[]
  tests     TestTrackerEnglishMain[]

  /// Grammar School, GCSE or A-Level (migration 032). Every student query
  /// filters on it, so a child only ever sees their own programme's content.
  programmeCode String    @default("GRAMMAR")
  programme     Programme @relation(fields: [programmeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([programmeCode, subjectName, difficultyLevel], map: "gsEnglishComp_programme_subject_level_idx")
  @@map("gsEnglishComp")
}

/// Questions hanging off a comprehension - selecting a comp shows all of these.
model GsEnglishQuestion {
  id             BigInt               @id @default(autoincrement())
  topic          String?
  quest          String?
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  optionE        String?
  ansChoice      String?
  gsEngCompId    BigInt
  comp           GsEnglishComp        @relation(fields: [gsEngCompId], references: [id], onDelete: Cascade)
  /// The comprehension skill this question tests - "Retrieval", "sequencing",
  /// "basic vocabulary" and so on. Difficulty now lives only on the
  /// comprehension; a question is described by what it asks for, not how hard
  /// it is, and this is what the parent report groups by.
  typeOfQuestion String?              @db.VarChar(256)
  trackerRows    TestTrackerEnglish[]

  @@index([gsEngCompId])
  @@map("gsEnglishQuestions")
}

/// Standalone Maths MCQs, picked by subTopic + difficultyLevel.
/// Unlike English these are not tied to a year or a comprehension.
model GsMathsQuestion {
  id              BigInt  @id @default(autoincrement())
  topic           String?
  subTopic        String?
  quest           String?
  optionA         String?
  optionB         String?
  optionC         String?
  optionD         String?
  optionE         String?
  ansChoice       String?
  difficultyLevel String?
  explanation     String?
  /// Optional diagram as inline SVG, shown above the options (migration
  /// 033). Executable markup is refused by the database and stripped again
  /// by sanitiseFigure before it is rendered.
  imageSvg        String?
  /// Present in the database and declared here so a schema sync can never
  /// drop it. Nothing reads it - Maths is not scoped by year.
  yearName        String? @db.VarChar(255)

  trackerRows TestTrackerMath[]

  /// Grammar School, GCSE or A-Level (migration 032). Every student query
  /// filters on it, so a child only ever sees their own programme's content.
  programmeCode String    @default("GRAMMAR")
  programme     Programme @relation(fields: [programmeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([subTopic, difficultyLevel])
  @@index([topic])
  @@index([programmeCode, subTopic, difficultyLevel], map: "gsMathsQuestions_programme_subTopic_level_idx")
  @@index([programmeCode, topic, difficultyLevel], map: "gsMathsQuestions_programme_topic_level_idx")
  @@map("gsMathsQuestions")
}

/// Non-Verbal Reasoning questions.
///
/// Figures are SVG markup rendered inline, which makes this the one bank whose
/// content becomes live markup in a browser. The database refuses anything
/// executable (see the nvr_no_markup check in migration 018) and the renderer
/// strips what survives - a regex blacklist is a second line, never the only one.
model GsNvrQuestion {
  id              BigInt  @id @default(autoincrement())
  /// Metadata only. Year stopped gating content; difficulty does that.
  yearName        String?
  subjectName     String  @default("Non-Verbal Reasoning")
  topic           String
  subTopic        String
  /// "Mirror image", "Quarter turn", "Sequence"... Same column name as
  /// gsEnglishQuestions, so the parent report groups by skill here too.
  typeOfQuestion  String
  difficultyLevel String
  quest           String

  /// stemFormat: "svg" | "url" | "none". optionFormat: the same plus "text"
  /// (migration 030) - both are constrained in the database.
  stemFormat   String  @default("svg")
  stemFigure   String?
  optionFormat String  @default("svg")
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  /// Four options is kinder at this age, so E stays optional.
  optionE      String?
  ansChoice    String  @db.Char(1)
  /// The "why", for a parent going through a wrong answer.
  ansExplain   String?
  /// Why each wrong option is wrong, shown when that option was chosen -
  /// the same columns as gsVRQuestions (migration 029).
  whyWrongA    String?
  whyWrongB    String?
  whyWrongC    String?
  whyWrongD    String?
  whyWrongE    String?

  /// Where the figure came from; keeps the bank clear of third-party material.
  assetOrigin String   @default("original-generated")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  trackerRows TestTrackerNvr[]

  /// Grammar School, GCSE or A-Level (migration 032). Every student query
  /// filters on it, so a child only ever sees their own programme's content.
  programmeCode String    @default("GRAMMAR")
  programme     Programme @relation(fields: [programmeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([topic, difficultyLevel], map: "gsNvrQuestions_topic_level_idx")
  @@index([subTopic, difficultyLevel], map: "gsNvrQuestions_subTopic_level_idx")
  @@index([typeOfQuestion], map: "gsNvrQuestions_typeOfQuestion_idx")
  @@index([programmeCode, topic, difficultyLevel], map: "gsNvrQuestions_programme_topic_level_idx")
  @@index([programmeCode, subTopic, difficultyLevel], map: "gsNvrQuestions_programme_subTopic_level_idx")
  @@map("gsNvrQuestions")
}

/// One row per Non-Verbal Reasoning round; its id identifies the test.
/// Mirrors the Maths and English pairs so one union spans every subject.
model TestTrackerNvrMain {
  id            BigInt      @id @default(autoincrement())
  studentId     BigInt
  student       UserProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testStartTime DateTime    @default(now()) @db.Timestamptz(3)

  topic            String?
  /// Null marks a whole-topic test spanning several subtopics.
  subTopic         String?
  difficultyLevel  String?
  completionReason String?

  questions TestTrackerNvr[]

  @@index([studentId, testStartTime])
  @@index([studentId, topic, subTopic, difficultyLevel, testStartTime], map: "testTrackerNvrMain_student_round_idx")
  @@map("testTrackerNvrMain")
}

/// One row per question answered within a Non-Verbal round.
model TestTrackerNvr {
  id         BigInt             @id @default(autoincrement())
  testId     BigInt
  test       TestTrackerNvrMain @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId BigInt
  /// Restrict: deleting a question must not erase a child's history of it.
  question   GsNvrQuestion      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  studentId  BigInt
  student    UserProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isAnsRight Boolean            @default(false)
  isSkipped  Boolean            @default(false)

  timeSpentOnQuestion Decimal?  @db.Decimal(7, 2)
  chosenOption        String?   @db.VarChar(1)
  correctOption       String?   @db.VarChar(1)
  questionOrder       Int?      @db.SmallInt
  /// Snapshot of the question type, which the parent report groups by.
  topic               String?
  /// Set from the answer sheet when the student finds the answer unclear.
  flaggedUnclear      Boolean   @default(false)
  flaggedUnclearAt    DateTime? @db.Timestamptz(3)

  @@index([testId])
  @@index([studentId, questionId])
  @@map("testTrackerNvr")
}

/// One row per Maths practice round; its id identifies the test.
model TestTrackerMathMain {
  id            BigInt      @id @default(autoincrement())
  studentId     BigInt
  student       UserProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testStartTime DateTime    @default(now()) @db.Timestamptz(3)

  /// What the round was, snapshotted so re-tagging a question later cannot
  /// move a past result into a different bucket.
  topic            String?
  /// Null marks a topic-level test spanning several subtopics.
  subTopic         String?
  difficultyLevel  String?
  /// "submitted" | "timed_out" | "abandoned" - a low score that ran out of
  /// time is a different finding from one handed in early.
  completionReason String?

  questions TestTrackerMath[]

  @@index([studentId, testStartTime])
  @@index([studentId, topic, subTopic, difficultyLevel, testStartTime], map: "testTrackerMathMain_student_round_idx")
  @@map("testTrackerMathMain")
}

/// One row per question answered within a test.
model TestTrackerMath {
  id                  BigInt              @id @default(autoincrement())
  questionId          BigInt
  /// Restrict: deleting a question must not erase a child's history of it.
  question            GsMathsQuestion     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  studentId           BigInt
  student             UserProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isAnsRight          Boolean             @default(false)
  isSkipped           Boolean             @default(false)
  testId              BigInt
  test                TestTrackerMathMain @relation(fields: [testId], references: [id], onDelete: Cascade)
  /// Seconds, to 2dp, clamped server-side before it is stored.
  timeSpentOnQuestion Decimal?            @db.Decimal(7, 2)

  /// Which answer was given and which was right - the wrong answer a child
  /// reaches for repeatedly says more than the fact that they were wrong.
  chosenOption     String?   @db.VarChar(1)
  correctOption    String?   @db.VarChar(1)
  /// Position in the round as presented, for spotting a late fall-off.
  questionOrder    Int?      @db.SmallInt
  /// Set from the answer sheet when the student finds the answer unclear.
  flaggedUnclear   Boolean   @default(false)
  flaggedUnclearAt DateTime? @db.Timestamptz(3)

  @@index([testId])
  @@index([studentId, questionId])
  @@map("testTrackerMath")
}

/// One row per English comprehension round; its id identifies the test.
///
/// Deliberately a mirror of TestTrackerMathMain: the common core columns are
/// named and typed identically in both, so one union across subjects answers
/// "which subject is weakest" without per-subject special casing.
model TestTrackerEnglishMain {
  id            BigInt      @id @default(autoincrement())
  studentId     BigInt
  student       UserProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testStartTime DateTime    @default(now()) @db.Timestamptz(3)

  /// Which comprehension was sat. Restrict: retiring one must not erase the
  /// history of it.
  gsEngCompId BigInt
  comp        GsEnglishComp @relation(fields: [gsEngCompId], references: [id], onDelete: Restrict)

  /// Snapshots taken at submission, so re-tagging a comprehension later cannot
  /// move a past result into a different bucket.
  /// topic holds the comprehension's title.
  topic           String?
  /// Reserved: an English round spans several question types, so this stays
  /// null until rounds can be narrowed to one type.
  subTopic        String?
  difficultyLevel String?
  yearName        String?

  /// Seconds from the story appearing to the first interaction with the
  /// question pane. English is read-then-answer, and a careful reader and a
  /// skimmer can land on the same score for opposite reasons.
  /// Per-question timing starts at this same instant, so nothing is counted twice.
  passageReadSeconds Decimal? @db.Decimal(7, 2)

  /// "submitted" | "timed_out" | "abandoned"
  completionReason String?

  /// Source Attempt.id when the round was carried in by migration 012;
  /// null for everything recorded live. Unique so a re-run cannot import the
  /// same attempt twice - Postgres treats nulls as distinct, so live rounds
  /// are unaffected.
  legacyAttemptId String? @unique

  questions TestTrackerEnglish[]

  @@index([studentId, testStartTime])
  @@index([studentId, gsEngCompId, difficultyLevel, testStartTime], map: "testTrackerEnglishMain_student_round_idx")
  @@map("testTrackerEnglishMain")
}

/// One row per question answered within an English test.
model TestTrackerEnglish {
  id         BigInt                 @id @default(autoincrement())
  testId     BigInt
  test       TestTrackerEnglishMain @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId BigInt
  /// Restrict: deleting a question must not erase a child's history of it.
  question   GsEnglishQuestion      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  studentId  BigInt
  student    UserProfile            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isAnsRight Boolean                @default(false)
  isSkipped  Boolean                @default(false)

  /// Seconds, to 2dp, clamped server-side before it is stored.
  timeSpentOnQuestion Decimal? @db.Decimal(7, 2)

  chosenOption  String? @db.VarChar(1)
  correctOption String? @db.VarChar(1)
  /// Position in the round. Questions about a passage run in text order, so a
  /// fall-off in the later ones separates "did not finish reading" from
  /// "did not understand".
  questionOrder Int?    @db.SmallInt
  /// Snapshot of the question's type tag (inference, vocabulary, retrieval).
  topic         String?

  @@index([testId])
  @@index([studentId, questionId])
  @@map("testTrackerEnglish")
}

/// The master list of school classes - Year 4, Year 5... - that pupils and
/// teachers are placed in. The table was "Year" until migration 037, then
/// masterSchoolClass until 039.
model Year {
  id             String               @id @default(cuid())
  name           String               @unique
  order          Int                  @default(0)
  subjects       Subject[]
  studentDetails UserStudentDetails[]
  classTeachers  SchoolClassTeacher[]

  @@map("coreSchoolClass")
}

model Subject {
  id     String @id @default(cuid())
  name   String
  order  Int    @default(0)
  yearId String
  year   Year   @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@unique([yearId, name])
}

/// Verbal Reasoning MCQs, picked by topic/subTopic + difficultyLevel like Maths.
/// Created by prisma/sql/021_verbal_reasoning.sql. Ids are BIGINT, as every
/// id in this schema is since migration 026.
model GsVrQuestion {
  id              BigInt  @id
  topic           String? @db.VarChar(255)
  subTopic        String? @db.VarChar(255)
  quest           String?
  optionA         String?
  optionB         String?
  optionC         String?
  optionD         String?
  optionE         String?
  ansChoice       String? @db.VarChar(10)
  explanation     String?
  difficultyLevel String? @db.VarChar(50)
  yearName        String? @db.VarChar(50)
  /// Why each wrong option is wrong, shown when that option was chosen.
  whyWrongA       String?
  whyWrongB       String?
  whyWrongC       String?
  whyWrongD       String?
  whyWrongE       String?

  trackerRows TestTrackerVr[]

  /// Grammar School, GCSE or A-Level (migration 032). Every student query
  /// filters on it, so a child only ever sees their own programme's content.
  programmeCode String    @default("GRAMMAR")
  programme     Programme @relation(fields: [programmeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([programmeCode, topic, subTopic, difficultyLevel], map: "gsVRQuestions_programme_topic_level_idx")
  @@map("gsVRQuestions")
}

/// One row per Verbal Reasoning round; its id identifies the test.
model TestTrackerVrMain {
  id               BigInt    @id @default(autoincrement())
  /// userProfile.id. No foreign key in the database.
  studentId        BigInt?
  /// TIMESTAMP without time zone in the database; written as UTC.
  testStartTime    DateTime? @db.Timestamp(6)
  topic            String?   @db.VarChar(255)
  /// Null marks a whole-topic test spanning several subtopics.
  subTopic         String?   @db.VarChar(255)
  difficultyLevel  String?   @db.VarChar(50)
  completionReason String?   @db.VarChar(100)

  questions TestTrackerVr[]

  @@index([studentId], map: "idx_testTrackerVRMain_studentId")
  @@map("testTrackerVRMain")
}

/// One row per question answered within a Verbal Reasoning round.
model TestTrackerVr {
  id                  BigInt             @id @default(autoincrement())
  questionId          BigInt?
  question            GsVrQuestion?      @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_testTrackerVR_question")
  studentId           BigInt?
  isAnsRight          Boolean?
  isSkipped           Boolean?
  testId              BigInt?
  test                TestTrackerVrMain? @relation(fields: [testId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_testTrackerVR_test")
  timeSpentOnQuestion Decimal?           @db.Decimal(10, 2)
  chosenOption        String?            @db.VarChar(10)
  correctOption       String?            @db.VarChar(10)
  questionOrder       Int?               @db.SmallInt
  /// Set from the answer sheet when the student finds the answer unclear.
  flaggedUnclear      Boolean            @default(false)
  flaggedUnclearAt    DateTime?          @db.Timestamptz(3)

  @@index([questionId], map: "idx_testTrackerVR_questionId")
  @@index([testId], map: "idx_testTrackerVR_testId")
  @@index([studentId], map: "idx_testTrackerVR_studentId")
  @@map("testTrackerVR")
}

/// A school, created by a Product Director (migration 036). Its School Admin,
/// teachers and pupils carry its id in userProfile.schoolId.
model School {
  id            BigInt       @id @default(autoincrement())
  name          String
  address1      String?
  address2      String?
  city          String?
  postcode      String?
  contactEmail  String?
  /// The programme every pupil of this school practises.
  programmeCode String       @default("GRAMMAR")
  programme     Programme    @relation(fields: [programmeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  /// Pupil seats; null means no limit.
  maxStudents   Int?
  isActive      Boolean      @default(true)
  createdById   BigInt?
  createdBy     UserProfile? @relation("SchoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  members       UserProfile[]        @relation("SchoolMembers")
  classTeachers SchoolClassTeacher[]

  @@map("coreSchool")
}

/// Which teachers take which classes (coreSchoolClass: Year 4, Year 5...)
/// in which school. A pupil's class is their studentYear. Was
/// schoolYearTeacher until migration 038, schoolClassTeacher until 041.
model SchoolClassTeacher {
  id          BigInt      @id @default(autoincrement())
  schoolId    BigInt
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// coreSchoolClass.id
  classId     String
  masterClass Year        @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacherId   BigInt
  teacher     UserProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  /// Set when the teacher is taken off the class; rows are never deleted.
  removedAt   DateTime?   @db.Timestamptz(3)

  @@unique([teacherId, classId], map: "coreSchoolClassTeacher_teacherId_classId_key")
  @@index([schoolId, classId], map: "coreSchoolClassTeacher_schoolId_classId_idx")
  @@map("coreSchoolClassTeacher")
}

/// One row each time a teacher opens a pupil on a classroom device. Closed
/// (endedAt set), never deleted, so it doubles as the audit trail.
model ClassroomSession {
  id        BigInt      @id @default(autoincrement())
  studentId BigInt
  student   UserProfile @relation("ClassroomStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId BigInt
  teacher   UserProfile @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  startedAt DateTime    @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?   @db.Timestamptz(3)
  /// "exit" | "ended_by_teacher" | "replaced" | "idle" | "school_inactive"
  endReason String?
  userAgent String?

  @@index([teacherId, endedAt])
  @@index([studentId, endedAt])
  @@map("classroomSession")
}
